# Copy to deploy/.env and fill in. NEVER commit the real .env.
# Public DNS name that both PCs can reach (also the coturn realm).
PUBLIC_HOST=turn.example.com

# HMAC key for signing session tokens: 32+ random bytes, base64.
#   generate:  openssl rand -base64 32
SESSION_TOKEN_KEY_BASE64=replace-with-openssl-rand-base64-32

# coturn REST shared secret (static-auth-secret). Must match on the signaling service.
#   generate:  openssl rand -hex 32
TURN_SHARED_SECRET=replace-with-openssl-rand-hex-32
