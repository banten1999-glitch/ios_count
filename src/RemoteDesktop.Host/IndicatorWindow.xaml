<Window x:Class="RemoteDesktop.Host.IndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote session active"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        Focusable="False" IsHitTestVisible="False">
    <Border CornerRadius="8" Background="#CC1F1F1F" Padding="12,6" BorderBrush="#FFE53935" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="10" Height="10" Fill="#FFE53935" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="Label" Foreground="White" FontSize="12" VerticalAlignment="Center"
                       Text="Remote session active"/>
        </StackPanel>
    </Border>
</Window>
