<Window x:Class="RemoteDesktop.Host.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair a new device" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="24" MinWidth="360">
        <TextBlock Text="Pair a new device" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="On the controlling PC, enter this Host ID and pairing code. You will be asked to confirm here before access is granted."/>
        <TextBlock Text="Host ID" FontWeight="SemiBold"/>
        <TextBox x:Name="HostIdBox" IsReadOnly="True" Margin="0,2,0,12" FontFamily="Consolas"/>
        <TextBlock Text="Pairing code (valid ~3 minutes)" FontWeight="SemiBold"/>
        <TextBox x:Name="CodeBox" IsReadOnly="True" Margin="0,2,0,12"
                 FontFamily="Consolas" FontSize="20" FontWeight="Bold"/>
        <Button Content="Close" Width="90" HorizontalAlignment="Right" Click="Close_Click"/>
    </StackPanel>
</Window>
