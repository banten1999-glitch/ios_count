<Window x:Class="RemoteDesktop.Host.TrustedDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trusted devices" Width="560" Height="360"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Trusted devices" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Revoke selected" Width="130" Margin="0,0,8,0" Click="Revoke_Click"/>
            <Button Content="Close" Width="90" Click="Close_Click"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="2*"/>
                <DataGridTextColumn Header="Paired" Binding="{Binding PairedAt}" Width="Auto"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
